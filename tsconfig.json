{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "vitest.config.ts", "tests/ui/**/*.ts", "tests/support/**/*.ts", "tests/api/**/*.ts", "tests/race/**/*.ts"],
  "exclude": ["node_modules", "tests/unit"]
}
